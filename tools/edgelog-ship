#!/bin/sh
# edgelog-ship: send a web server's access log to Edgelog.
#
# One POSIX shell script. It needs nothing a fresh Debian or Ubuntu does not
# already have: sh, coreutils, gzip, and curl or GNU wget.
#
#     edgelog-ship --url https://edgelog.example.com/ingest/<site uuid> \
#                  --token-file /etc/edgelog-ship/token \
#                  --log /var/log/nginx/access.log \
#                  [--state /var/lib/edgelog-ship/state] \
#                  [--batch-lines 2000] [--interval 10] [--from-end] [--once]
#                  [--metrics [--fpm-status <url>]... [--nginx-status <url>]]
#
#     edgelog-ship --url ... --token-file ... --errors laravel|codeigniter|craft|php \
#                  --log '/home/forge/example.com/storage/logs/laravel.log' \
#                  --state /var/lib/edgelog-ship/errors-laravel.state
#
#     edgelog-ship --url ... --token-file ... --backfill /var/log/nginx/access.log*
#
#     edgelog-ship --print-metrics [--fpm-status <url>]... [--nginx-status <url>]
#
# How it keeps every line, once:
#
#   * Only whole lines are sent; a last line still being written waits for
#     its end. A line longer than 64 KiB is cut to 64 KiB.
#   * Every --interval seconds, the new lines (at most --batch-lines and
#     4 MiB a batch) are sent gzip'd. A full batch is followed by the next
#     one at once.
#   * Every batch is numbered, X-Edgelog-Batch: <shipper id>:<seq>. Before a
#     batch is sent, its number and where it ends are saved; after a restart
#     the very same bytes are sent again with the same number, so the server
#     keeps a batch whose answer was lost once.
#   * The place in the log (device:inode, offset) is saved only after the
#     server answered 2xx (a temp file, then a rename).
#   * Rotation: when the log's path names a new file, the old one is read to
#     its end as <log>.1 (a last unfinished line included), then the new one
#     from its start. Truncation in place (copytruncate) starts again at 0.
#   * Failures never drop a line. 413 halves the batch. 429, 503 and 507 wait
#     for Retry-After (at most 10 minutes). Anything else (no network, 5xx,
#     401, 403, 404) waits 1 s doubling up to 5 minutes, with jitter, and
#     tries again, for ever. Each failure is one line on stderr with the
#     server's reason, never the token.
#   * --once sends what is there and exits; it gives up (exit 1, place kept)
#     after 5 failed tries of a batch or 60 s of waiting in all.
#   * SIGTERM / SIGINT: the batch in flight gets its answer, then it exits 0.
#
# --backfill sends the web server's past log files instead, given after it,
# plain or gzip'd, oldest first, to <url>/history, then exits. Start the
# live shipper first: the server keeps only the past lines older than the
# first one it shipped. Each file is known by the sha256 of its first line,
# unpacked, which stays the same when logrotate renames or compresses it,
# and while it grows; the server keeps how far each file went, so running
# the command again goes on where it stopped and sends nothing twice. A gzip'd
# file is unpacked next to the state file while it is sent. It gives up
# (exit 1) after 5 failed tries of a part.
#
# --errors <kind> sends an application's error log instead, to
# <url>/errors/<kind>: laravel (laravel.log), codeigniter (writable/logs),
# craft (storage/logs/web-*.log) or php (php.ini's error_log). Run one shipper
# per log, each with its own --state. A --log with a * in it (quote it) follows
# the newest file of an app that writes one a day: once a newer one appears,
# the one being read is read to its end, then the newer one from its start. A
# line longer than 64 KiB keeps its start and its end, where an exception
# names its class and file, with what was cut in the middle.
#
# --metrics also sends the server's own figures to <url>/metrics, once a
# minute, from /proc and df (awk reads them): the processors' busy share,
# load, memory and swap, each disk's space, and the disk and network bytes a
# second. They are never kept back: a minute the server does not take is
# skipped, and the log lines go on all the same. Each sample names the
# machine by a hash of its /etc/machine-id (never the id itself) and its host
# name, so the sites whose shippers run on it share one server, its figures
# kept once. Once an hour (and with the first sample), a sample also says
# what runs on the machine: its system (/etc/os-release), and the version of
# each PHP (with FPM's display_errors, expose_php and opcache.enable),
# nginx, Apache, MySQL or MariaDB, PostgreSQL, Redis, Memcached, Node.js
# (the system's and each one nvm installed), OpenSSL and the running kernel
# found, each with the Debian package it
# comes from when dpkg knows it; Edgelog sets them against their end of life
# and the known flaws (CVE). With them goes the machine's state: whether a
# reboot is waited for, the updates waiting and whether security ones are
# installed by themselves, the TCP addresses listened on, sshd's
# PermitRootLogin and PasswordAuthentication, and the failed services. --print-metrics prints one sample,
# read over a second, with what runs on the machine, and exits; it needs no
# URL or token.
#
# --fpm-status <url> (once per PHP-FPM pool) and --nginx-status <url> add the
# web server to each sample: the pool's status page (pm.status_path, read as
# JSON: ?json is added to a URL without a query) and nginx's stub_status,
# both served on a local address only, e.g. http://127.0.0.1:8081/php-fpm-status.
# The pools are summed up: the workers busy and started, the requests waiting
# for one, the requests a second, and how many times pm.max_children was
# reached and requests were slow (request_slowlog_timeout) since the sample
# before; nginx's open connections and requests a second. Each pool is also
# sent on its own, by its name (1.6.0): its workers busy and started, the
# requests waiting, its requests a second and the times it reached
# pm.max_children. The status request
# itself is not counted. A page that does not answer in 3 seconds is left out
# of the sample, never sent the token.
#
# The token is never put on a command line (other users could read it in
# the process list): curl and wget read it from a file only this user reads.
# The URL must be https://; plain http:// only to localhost, 127.0.0.1 or ::1.

set -u

VERSION=1.6.0
MAX_BATCH_BYTES=4194304
MAX_LINE=65536
MAX_RETRY_AFTER=600
BACKOFF_CAP=300
ONCE_TRIES=5
ONCE_SECONDS=60

URL=
TOKEN_FILE=
LOG=
STATE=/var/lib/edgelog-ship/state
BATCH_LINES=2000
INTERVAL=10
FROM_END=0
ONCE=0
BACKFILL=0
METRICS=0
MACHINE=
PRINT_METRICS=0
METRICS_EVERY=60
SOFTWARE_EVERY=3600
SOFTWARE_AT=0
SOFTWARE_ADDED=0
ERRORS=
PATTERN=
FPM_STATUS=
NGINX_STATUS=

say() {
    printf 'edgelog-ship: %s\n' "$*" >&2
}

die() {
    say "$*"
    exit 2
}

usage() {
    sed -n '2,21s/^# \{0,1\}//p' "$0"
    exit "${1:-0}"
}

need_value() {
    [ "$2" -ge 2 ] || die "$1 needs a value"
}

# ---------------------------------------------------------------- metrics

# The machine, by a hash of its id: the same for every shipper on it, and
# nothing that tells the id itself. Empty when there is no id to read.
machine_hash() {
    command -v sha256sum >/dev/null 2>&1 || return 0
    for file in /etc/machine-id /var/lib/dbus/machine-id; do
        if [ -s "$file" ]; then
            { printf 'edgelog:'; tr -d ' \t\r\n' < "$file"; } | sha256sum | cut -c1-32
            return 0
        fi
    done
}

# Read the server's figures into $WORK/metrics.json. The counters (processor
# time, disk sectors, network bytes) are kept in $WORK/metrics.last, so the
# busy share and the bytes a second are those since the reading before; the
# first reading, or one after a reboot, has none (null).
read_metrics() {
    df -P -k -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null > "$WORK/df"
    read_status
    LC_ALL=C awk -v now="$(date +%s)" -v previous="$WORK/metrics.last" -v keep="$WORK/metrics.keep" -v df="$WORK/df" \
        -v machine="$MACHINE" -v host="$(uname -n 2>/dev/null)" -v fpm="$WORK/fpm" -v nginx="$WORK/nginx" '
        function number(value) { return sprintf("%.0f", value) }
        function per_second(now_value, then_value) {
            return (elapsed > 0 && then_value != "" && then_value != "-" && now_value >= then_value + 0) ? sprintf("%.2f", (now_value - then_value) / elapsed) : "null"
        }
        function since(now_value, then_value) {
            return (then_value != "" && then_value != "-" && now_value >= then_value + 0) ? number(now_value - then_value) : "null"
        }
        # A whole number of a JSON object on one line, by its key; empty when it has none.
        function json_number(json, key,    at, rest) {
            at = index(json, "\"" key "\":")
            if (at == 0) return ""
            rest = substr(json, at + length(key) + 3)
            sub(/^[ \t]+/, "", rest)
            return match(rest, /^[0-9]+/) ? substr(rest, 1, RLENGTH) : ""
        }
        # A string of a JSON object on one line, by its key, without escapes; empty when it has none.
        function json_text(json, key,    at, rest) {
            at = index(json, "\"" key "\":")
            if (at == 0) return ""
            rest = substr(json, at + length(key) + 3)
            sub(/^[ \t]+/, "", rest)
            return match(rest, /^"[^"\\]*"/) ? substr(rest, 2, RLENGTH - 2) : ""
        }
        function rate(now_value, then_value) {
            return (elapsed > 0 && now_value >= then_value) ? number((now_value - then_value) / elapsed) : "null"
        }
        function text(value) { gsub(/\\/, "\\\\", value); gsub(/"/, "\\\"", value); return "\"" value "\"" }

        FILENAME == "/proc/stat" && $1 == "cpu" {
            for (i = 2; i <= 9 && i <= NF; i++) total += $i
            idle = $5 + $6
            iowait = $6
        }
        FILENAME == "/proc/stat" && $1 ~ /^cpu[0-9]+$/ { cores++ }
        FILENAME == "/proc/meminfo" { memory[$1] = $2 * 1024 }
        FILENAME == "/proc/loadavg" { load1 = $1; load5 = $2; load15 = $3 }
        FILENAME == "/proc/uptime" { uptime = int($1) }
        FILENAME == "/proc/net/dev" && FNR > 2 {
            line = $0
            sub(/^[ \t]+/, "", line)
            split(line, parts, ":")
            if (parts[1] ~ /^(lo|veth|docker|br-|virbr)/) next
            split(parts[2], counters, " ")
            received += counters[1]
            sent += counters[9]
        }
        FILENAME == "/proc/diskstats" {
            if ($3 ~ /^(loop|ram|zram|dm-|md|sr|fd)/) next
            whole = "/sys/block/" $3 "/stat"
            if ((getline ignored < whole) > 0) {
                read += $6 * 512
                written += $10 * 512
            }
            close(whole)
        }

        END {
            if ((getline was < previous) > 0) split(was, then, " ")
            elapsed = (1 in then) ? now - then[1] : 0
            if (elapsed > 0 && total > then[2]) {
                cpu = sprintf("%.1f", 100 * ((total - then[2]) - (idle - then[3])) / (total - then[2]))
                wait = sprintf("%.1f", 100 * (iowait - then[4]) / (total - then[2]))
            } else {
                cpu = "null"
                wait = "null"
            }
            available = ("MemAvailable:" in memory) ? memory["MemAvailable:"] : memory["MemFree:"] + memory["Buffers:"] + memory["Cached:"]

            disks = ""
            count = 0
            while ((getline row < df) > 0 && count < 32) {
                if (++rows == 1) continue
                n = split(row, field, " ")
                if (n < 6 || field[2] == 0) continue
                mount = field[6]
                for (i = 7; i <= n; i++) mount = mount " " field[i]
                disks = disks (count++ ? "," : "") "{\"mount\":" text(mount) ",\"size\":" number(field[2] * 1024) ",\"used\":" number(field[3] * 1024) ",\"free\":" number(field[4] * 1024) "}"
            }

            # Each pool of PHP-FPM, summed up and on its own; its start times
            # tell a restart, after which its counters start again from 0.
            # The counters of each pool are kept as name|start|accepted|reached;...
            if (14 in then && then[14] != "-") {
                split(then[14], entries, ";")
                for (i in entries) {
                    if (split(entries[i], kept, "|") == 4) {
                        pool_then_start[kept[1]] = kept[2]
                        pool_then_accepted[kept[1]] = kept[3]
                        pool_then_reached[kept[1]] = kept[4]
                    }
                }
            }
            pools = 0
            signature = ""
            by_pool = ""
            pool_counters = ""
            while ((getline row < fpm) > 0) {
                started = json_number(row, "start time")
                accepted_now = json_number(row, "accepted conn")
                if (started == "" || accepted_now == "") { signature = signature "x;"; continue }
                pools++
                signature = signature started ";"
                busy = json_number(row, "active processes") - 1
                busy = busy > 0 ? busy : 0
                reached_now = json_number(row, "max children reached") + 0
                fpm_active += busy
                fpm_total += json_number(row, "total processes")
                fpm_queue += json_number(row, "listen queue")
                fpm_accepted += accepted_now
                fpm_reached += reached_now
                fpm_slow += json_number(row, "slow requests")

                name = json_text(row, "pool")
                gsub(/[^A-Za-z0-9_.-]/, "", name)
                name = substr(name, 1, 32)
                if (name == "") name = "pool" pools
                same_pool = (name in pool_then_start) && pool_then_start[name] == started
                if (pools <= 16) {
                    by_pool = by_pool (pools > 1 ? "," : "") "{\"name\":" text(name) ",\"active\":" number(busy) ",\"total\":" number(json_number(row, "total processes")) ",\"queue\":" number(json_number(row, "listen queue"))
                    by_pool = by_pool ",\"requests\":" (same_pool ? per_second(accepted_now, pool_then_accepted[name]) : "null") ",\"saturated\":" (same_pool ? since(reached_now, pool_then_reached[name]) : "null") "}"
                }
                pool_counters = pool_counters (pools > 1 ? ";" : "") name "|" started "|" accepted_now "|" reached_now
            }
            close(fpm)
            same_pools = pools > 0 && (9 in then) && then[9] == signature

            nginx_read = 0
            while ((getline row < nginx) > 0) {
                if (row ~ /^Active connections:/) {
                    split(row, part, ":")
                    connections = part[2] - 1
                    nginx_read = 1
                } else if (row ~ /^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+[0-9]+[ \t]*$/) {
                    split(row, part, " ")
                    nginx_requests = part[3]
                }
            }
            close(nginx)
            if (nginx_requests == "") nginx_read = 0

            print now, number(total), number(idle), number(iowait), number(read), number(written), number(received), number(sent), \
                (pools > 0 ? signature : "-"), (pools > 0 ? number(fpm_accepted) : "-"), (pools > 0 ? number(fpm_reached) : "-"), (pools > 0 ? number(fpm_slow) : "-"), \
                (nginx_read ? number(nginx_requests) : "-"), (pools > 0 ? pool_counters : "-") > keep
            printf "{\"uptime\":%s,\"cores\":%d,\"cpu\":%s,\"iowait\":%s,\"load1\":%s,\"load5\":%s,\"load15\":%s,", uptime, cores, cpu, wait, load1, load5, load15
            printf "\"memory_total\":%s,\"memory_available\":%s,\"swap_total\":%s,\"swap_free\":%s,", number(memory["MemTotal:"]), number(available), number(memory["SwapTotal:"]), number(memory["SwapFree:"])
            printf "\"disk_read\":%s,\"disk_write\":%s,\"network_in\":%s,\"network_out\":%s,", rate(read, then[5]), rate(written, then[6]), rate(received, then[7]), rate(sent, then[8])
            printf "\"machine_id\":%s,\"hostname\":%s,", (machine == "" ? "null" : text(machine)), (host == "" ? "null" : text(host))
            if (pools > 0) {
                printf "\"php_fpm\":{\"pools\":%d,\"active\":%s,\"total\":%s,\"queue\":%s,", pools, number(fpm_active), number(fpm_total), number(fpm_queue)
                printf "\"requests\":%s,\"saturated\":%s,\"slow\":%s,\"by_pool\":[%s]},", same_pools ? per_second(fpm_accepted, then[10]) : "null", same_pools ? since(fpm_reached, then[11]) : "null", same_pools ? since(fpm_slow, then[12]) : "null", by_pool
            }
            if (nginx_read) {
                printf "\"nginx\":{\"connections\":%s,\"requests\":%s},", number(connections < 0 ? 0 : connections), per_second(nginx_requests, then[13])
            }
            printf "\"disks\":[%s]}\n", disks
        }
    ' /proc/stat /proc/meminfo /proc/loadavg /proc/uptime /proc/net/dev /proc/diskstats > "$WORK/metrics.json" || return 1
    mv -f "$WORK/metrics.keep" "$WORK/metrics.last"
}

# Fetch one local status page into <file>, for at most 3 seconds and 64 KiB,
# without the token. The file is empty when the page does not answer.
fetch_status() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS -m 3 --max-filesize 65536 -o "$2" "$1" 2>/dev/null
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T 3 -t 1 -O "$2" "$1" 2>/dev/null
    else
        false
    fi || : > "$2"
}

# Read each PHP-FPM pool's status page into $WORK/fpm, one line a pool (an
# empty one for a pool that did not answer), and nginx's into $WORK/nginx.
read_status() {
    : > "$WORK/fpm"
    for status in $FPM_STATUS; do
        case $status in *\?*) ;; *) status="$status?json" ;; esac
        fetch_status "$status" "$WORK/status"
        { tr -d '\r\n' < "$WORK/status"; printf '\n'; } >> "$WORK/fpm"
    done
    : > "$WORK/nginx"
    [ -z "$NGINX_STATUS" ] || fetch_status "$NGINX_STATUS" "$WORK/nginx"
}

# ---------------------------------------------------------------- software

# Run a command for at most <seconds> when timeout is there, its errors
# with its output.
limited() {
    seconds=$1
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$seconds" "$@" 2>&1
    else
        "$@" 2>&1
    fi
}

# Run a program that says its version, for at most 5 seconds.
ask() {
    limited 5 "$@"
}

# Where a program is; empty when it is not there. Services often have it in
# an sbin folder that is not on the PATH. Links are kept: redis-server is a
# link to a program that answers otherwise under another name.
program() {
    found=$(command -v "$1" 2>/dev/null) || found=
    if [ -z "$found" ]; then
        for dir in /usr/sbin /usr/local/sbin /sbin; do
            [ -x "$dir/$1" ] && found=$dir/$1 && break
        done
    fi
    printf '%s' "$found"
}

# The first word of what a program says that starts with a number, after
# <prefix> when one is given, kept to the characters of a version.
version_word() {
    LC_ALL=C awk -v prefix="$1" '{
        for (i = 1; i <= NF; i++) {
            word = $i
            if (prefix != "" && index(word, prefix) != 1) continue
            word = substr(word, length(prefix) + 1)
            if (word ~ /^[0-9]+\.[0-9]+/) { gsub(/[^A-Za-z0-9.+~:_-]/, "", word); print word; exit }
        }
    }'
}

# The Debian package a file comes from: its source package and version,
# tab-separated. Nothing without dpkg, or when no package owns the file.
package_of() {
    command -v dpkg-query >/dev/null 2>&1 || return 0
    file=$(readlink -f "$1" 2>/dev/null) || file=$1
    for owned in "$file" "${file#/usr}"; do
        owner=$(dpkg-query -S "$owned" 2>/dev/null | grep -v '^diversion' | head -n 1 | cut -d: -f1)
        [ -z "$owner" ] || break
    done
    [ -z "$owner" ] || dpkg-query -W -f='${source:Package}\t${Version}' "$owner" 2>/dev/null | head -n 1
}

# One program found: product, version, its package and the package's
# version, then its settings (name=value,...), tab-separated. Nothing when
# it said no version.
software_line() {
    [ -n "$3" ] || return 0
    package=$(package_of "$2")
    case $2 in */.nvm/*) [ -n "$package" ] || package=nvm ;; esac
    [ -n "$package" ] || package=$(printf '\t')
    printf '%s\t%s\t%s\t%s\n' "$1" "$3" "$package" "${4:-}"
}

# The PHP settings that matter on a public server, as FPM reads them.
php_settings() {
    ask "$1" -i | LC_ALL=C awk -F ' => ' '
        $1 == "display_errors" || $1 == "expose_php" || $1 == "opcache.enable" { printf "%s%s=%s", (count++ ? "," : ""), $1, $2 }
    '
}

# sshd's settings as it reads them: its main file, the files it includes
# where it includes them, up to the first Match block; the first value of
# each wins. "partial=1" when an included file cannot be read.
ssh_settings() {
    [ -r /etc/ssh/sshd_config ] || return 0
    partial=0
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            [Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]*)
                for included in $(printf '%s\n' "$line" | cut -d' ' -f2-); do
                    case $included in /*) ;; *) included=/etc/ssh/$included ;; esac
                    for file in $included; do
                        [ -e "$file" ] || continue
                        if [ -r "$file" ]; then cat "$file"; echo; else partial=1; fi
                    done
                done
                ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < /etc/ssh/sshd_config > "$WORK/sshd"
    LC_ALL=C awk -v partial="$partial" '
        tolower($1) == "match" { exit }
        { key = tolower($1) }
        (key == "permitrootlogin" || key == "passwordauthentication") && !(key in seen) { seen[key] = tolower($2) }
        END {
            printf "permit_root_login=%s,password_authentication=%s,partial=%s", seen["permitrootlogin"], seen["passwordauthentication"], partial
        }
    ' "$WORK/sshd"
}

# The machine's state into $WORK/system.env, one name=value a line: a
# reboot waited for, the updates waiting (from apt's own lists, as apt's
# daily timer keeps them), automatic security updates, the TCP addresses
# listened on (loopback left out), sshd's settings, the failed services.
read_system() {
    {
        if [ -e /var/run/reboot-required ]; then echo reboot=true; else echo reboot=false; fi
        [ ! -r /var/run/reboot-required.pkgs ] || echo "reboot_packages=$(sort -u /var/run/reboot-required.pkgs | head -n 20 | paste -sd, -)"

        if command -v apt-get >/dev/null 2>&1 && LC_ALL=C limited 120 apt-get -s -o Debug::NoLocking=1 dist-upgrade > "$WORK/apt"; then
            echo "updates=$(grep -c '^Inst ' "$WORK/apt")"
            echo "security_updates=$(grep '^Inst ' "$WORK/apt" | grep -ci 'security')"
        fi
        if command -v apt-config >/dev/null 2>&1; then
            if command -v unattended-upgrade >/dev/null 2>&1 && apt-config dump 2>/dev/null | grep -q 'APT::Periodic::Unattended-Upgrade "1"'; then
                echo unattended=true
            else
                echo unattended=false
            fi
        fi

        if command -v ss >/dev/null 2>&1; then
            echo "listening=$(ss -tln 2>/dev/null | awk 'NR > 1 { print $4 }' | grep -v -e '^127\.' -e '^\[::1\]' -e '^\[::ffff:127\.' -e '%lo:' | sort -u | head -n 64 | paste -sd, -)"
        fi

        settings=$(ssh_settings)
        [ -z "$settings" ] || echo "ssh=$settings"

        if command -v systemctl >/dev/null 2>&1; then
            echo "failed_units=$(systemctl list-units --state=failed --plain --no-legend --no-pager 2>/dev/null | awk '{ print $1 }' | head -n 20 | paste -sd, -)"
        fi
    } > "$WORK/system.env"
}

# What runs on the machine into $WORK/software.json: the system and its
# state, then each PHP (every version installed, command line and FPM, with
# FPM's settings), nginx, Apache, the MySQL or MariaDB server, PostgreSQL,
# Redis, Memcached, Node.js, OpenSSL and the running kernel.
read_software() {
    os=$(. /etc/os-release 2>/dev/null; printf '%s' "${ID:-}" | tr -cd 'a-z0-9._-')
    os_version=$(. /etc/os-release 2>/dev/null; printf '%s' "${VERSION_ID:-}" | tr -cd 'A-Za-z0-9._-')
    read_system
    {
        seen=
        for path in $(program php) /usr/bin/php[0-9]*.[0-9]* /usr/sbin/php-fpm[0-9]*.[0-9]*; do
            [ -x "$path" ] || continue
            path=$(readlink -f "$path")
            case " $seen " in *" $path "*) continue ;; esac
            seen="$seen $path"
            settings=
            case ${path##*/} in php-fpm*) settings=$(php_settings "$path") ;; esac
            software_line php "$path" "$(ask "$path" -n -v | grep -m 1 '^PHP ' | version_word '')" "$settings"
        done

        path=$(program nginx)
        [ -z "$path" ] || software_line nginx "$path" "$(ask "$path" -v | version_word nginx/)"

        path=$(program apache2)
        [ -n "$path" ] || path=$(program httpd)
        [ -z "$path" ] || software_line apache "$path" "$(ask "$path" -v | version_word Apache/)"

        for name in mariadbd mysqld; do
            path=$(program "$name")
            [ -n "$path" ] || continue
            said=$(ask "$path" --version)
            case $said in *MariaDB*) product=mariadb ;; *) product=mysql ;; esac
            software_line "$product" "$path" "$(printf '%s\n' "$said" | version_word '')"
            break
        done

        for path in /usr/lib/postgresql/*/bin/postgres /usr/pgsql-*/bin/postgres; do
            [ -x "$path" ] && software_line postgresql "$path" "$(ask "$path" --version | version_word '')"
        done

        path=$(program redis-server)
        [ -z "$path" ] || software_line redis "$path" "$(ask "$path" --version | version_word v=)"

        path=$(program memcached)
        [ -z "$path" ] || software_line memcached "$path" "$(ask "$path" -V | version_word '')"

        # The system's Node, then each one nvm installed (Forge's deployments
        # use nvm's): those of this user, and of the others whose home it reads.
        seen=
        for path in $(program node) $(program nodejs) "${HOME:-/nonexistent}"/.nvm/versions/node/*/bin/node /home/*/.nvm/versions/node/*/bin/node; do
            [ -x "$path" ] || continue
            resolved=$(readlink -f "$path")
            case " $seen " in *" $resolved "*) continue ;; esac
            seen="$seen $resolved"
            software_line nodejs "$path" "$(ask "$path" -v | version_word v)"
        done

        path=$(program openssl)
        [ -z "$path" ] || software_line openssl "$path" "$(ask "$path" version | version_word '')"

        kernel=$(uname -r 2>/dev/null)
        [ -z "$kernel" ] || software_line linux "/lib/modules/$kernel/modules.builtin" "$(printf '%s\n' "$kernel" | version_word '')"
    } | LC_ALL=C sort -u | head -n 60 | LC_ALL=C awk -F '\t' -v os="$os" -v os_version="$os_version" -v machine_state="$WORK/system.env" '
        function text(value) { gsub(/\\/, "\\\\", value); gsub(/"/, "\\\"", value); return "\"" value "\"" }
        function maybe(value) { return value == "" ? "null" : text(value) }
        function list(csv,    parts, n, i, out) {
            n = split(csv, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] != "") out = out (out == "" ? "" : ",") text(parts[i])
            return "[" out "]"
        }
        function pairs(csv,    parts, n, i, at, out) {
            n = split(csv, parts, ",")
            for (i = 1; i <= n; i++) {
                at = index(parts[i], "=")
                if (at > 1) out = out (out == "" ? "" : ",") text(substr(parts[i], 1, at - 1)) ":" maybe(substr(parts[i], at + 1))
            }
            return "{" out "}"
        }
        NF >= 2 && $2 != "" {
            programs = programs (count++ ? "," : "") "{\"product\":" text($1) ",\"version\":" text($2) ",\"package\":" maybe($3) ",\"package_version\":" maybe($4) ",\"settings\":" ($5 == "" ? "null" : pairs($5)) "}"
        }
        END {
            while ((getline line < machine_state) > 0) {
                at = index(line, "=")
                if (at > 1) state[substr(line, 1, at - 1)] = substr(line, at + 1)
            }
            printf "{\"os\":%s,\"os_version\":%s,\"programs\":[%s],", maybe(os), maybe(os_version), programs
            printf "\"system\":{\"reboot_required\":%s,", ("reboot" in state) ? state["reboot"] : "null"
            printf "\"reboot_packages\":%s,", ("reboot_packages" in state) ? list(state["reboot_packages"]) : "[]"
            printf "\"updates\":%s,", ("updates" in state) ? state["updates"] + 0 : "null"
            printf "\"security_updates\":%s,", ("security_updates" in state) ? state["security_updates"] + 0 : "null"
            printf "\"unattended_upgrades\":%s,", ("unattended" in state) ? state["unattended"] : "null"
            printf "\"listening\":%s,", ("listening" in state) ? list(state["listening"]) : "null"
            printf "\"ssh\":%s,", ("ssh" in state) ? pairs(state["ssh"]) : "null"
            printf "\"failed_units\":%s}}", ("failed_units" in state) ? list(state["failed_units"]) : "null"
        }
    ' > "$WORK/software.json"
}

# Add what runs on the machine to the sample read last, once an hour after
# the last one the server took (with the first sample too), or now.
add_software() {
    SOFTWARE_ADDED=0
    [ "${1:-}" = now ] || [ "$(($(date +%s) - SOFTWARE_AT))" -ge "$SOFTWARE_EVERY" ] || return 0
    read_software || return 0
    { sed '$ s/}$//' "$WORK/metrics.json"; printf ',"software":'; cat "$WORK/software.json"; printf '}\n'; } > "$WORK/metrics.with" \
        && mv -f "$WORK/metrics.with" "$WORK/metrics.json" \
        && SOFTWARE_ADDED=1
}

while [ $# -gt 0 ]; do
    case $1 in
        --url) need_value "$1" $#; URL=$2; shift 2 ;;
        --token-file) need_value "$1" $#; TOKEN_FILE=$2; shift 2 ;;
        --log) need_value "$1" $#; LOG=$2; shift 2 ;;
        --state) need_value "$1" $#; STATE=$2; shift 2 ;;
        --batch-lines) need_value "$1" $#; BATCH_LINES=$2; shift 2 ;;
        --interval) need_value "$1" $#; INTERVAL=$2; shift 2 ;;
        --from-end) FROM_END=1; shift ;;
        --once) ONCE=1; shift ;;
        --metrics) METRICS=1; shift ;;
        --errors) need_value "$1" $#; ERRORS=$2; shift 2 ;;
        --print-metrics) PRINT_METRICS=1; shift ;;
        --fpm-status) need_value "$1" $#; FPM_STATUS="$FPM_STATUS $2"; shift 2 ;;
        --nginx-status) need_value "$1" $#; NGINX_STATUS=$2; shift 2 ;;
        --backfill) BACKFILL=1; shift; break ;;
        --version) echo "edgelog-ship $VERSION"; exit 0 ;;
        -h|--help) usage 0 ;;
        *) say "unknown option: $1"; usage 2 ;;
    esac
done

if [ -n "$FPM_STATUS$NGINX_STATUS" ]; then
    [ "$METRICS" -eq 1 ] || [ "$PRINT_METRICS" -eq 1 ] || die "--fpm-status and --nginx-status go with --metrics"
    for status in $FPM_STATUS $NGINX_STATUS; do
        case $status in http://?*|https://?*|file:///?*) ;; *) die "a status page is read over http:// or https://: $status" ;; esac
    done
fi

if [ "$METRICS" -eq 1 ] || [ "$PRINT_METRICS" -eq 1 ]; then
    [ -r /proc/stat ] || die "--metrics reads /proc, which this system does not have"
    command -v awk >/dev/null 2>&1 || die "awk is needed to read the server's figures"
    MACHINE=$(machine_hash)
fi

if [ "$PRINT_METRICS" -eq 1 ]; then
    WORK=$(mktemp -d) || die "no temporary folder"
    trap 'rm -rf "$WORK"' EXIT
    read_metrics && sleep 1 && read_metrics || die "the server's figures cannot be read"
    add_software now
    cat "$WORK/metrics.json"
    exit 0
fi

[ -n "$URL" ] && [ -n "$TOKEN_FILE" ] || usage 2
if [ "$BACKFILL" -eq 1 ]; then
    [ $# -gt 0 ] || die "--backfill needs the past log files after it"
    [ "$METRICS" -eq 0 ] || die "--metrics goes with the live shipper, not --backfill"
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is needed"
else
    [ -n "$LOG" ] || usage 2
fi

case $ERRORS in
    ''|laravel|codeigniter|craft|php) ;;
    *) die "--errors takes laravel, codeigniter, craft or php" ;;
esac
if [ -n "$ERRORS" ]; then
    [ "$BACKFILL" -eq 0 ] || die "--errors goes with the live shipper, not --backfill"
    [ "$METRICS" -eq 0 ] || die "--metrics goes with the shipper of the access log, not --errors"
    command -v awk >/dev/null 2>&1 || die "awk is needed to send an error log"
fi
case $LOG in *[*?[]*) PATTERN=$LOG ;; esac

case $BATCH_LINES in ''|*[!0-9]*|0) die "--batch-lines must be a whole number above 0" ;; esac
case $INTERVAL in ''|*[!0-9]*) die "--interval must be a whole number of seconds" ;; esac

case $URL in
    https://?*) ;;
    http://localhost|http://localhost[:/]*|http://127.0.0.1|http://127.0.0.1[:/]*|http://\[::1\]*) ;;
    *) die "the URL must start with https:// (http:// only to localhost)" ;;
esac

if command -v curl >/dev/null 2>&1; then
    CLIENT=curl
elif command -v wget >/dev/null 2>&1 && wget --version 2>/dev/null | grep -q 'GNU Wget'; then
    CLIENT=wget
else
    die "curl or GNU wget is needed to send the lines"
fi
command -v gzip >/dev/null 2>&1 || die "gzip is needed"

[ -r "$TOKEN_FILE" ] || die "the token file $TOKEN_FILE cannot be read"
TOKEN=$(tr -d ' \t\r\n' < "$TOKEN_FILE")
[ -n "$TOKEN" ] || die "the token file $TOKEN_FILE is empty"

umask 077
mkdir -p "$(dirname "$STATE")" || die "the state folder cannot be made"
WORK=$(mktemp -d "$(dirname "$STATE")/.edgelog-ship.XXXXXX") || die "no temporary folder"
trap 'rm -rf "$WORK"' EXIT
STOPPING=0
trap 'STOPPING=1' TERM INT

printf 'Authorization: Bearer %s\n' "$TOKEN" > "$WORK/auth"
printf 'header = Authorization: Bearer %s\n' "$TOKEN" > "$WORK/wgetrc"
unset TOKEN

# ---------------------------------------------------------------- state

state_get() {
    sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n 1
}

number_or() {
    case $1 in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac
}

random_hex() {
    od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'
}

random_number() {
    od -An -N2 -tu2 /dev/urandom | tr -d ' \n'
}

clear_inflight() {
    INFLIGHT_SEQ=
    INFLIGHT_FILE=
    INFLIGHT_START=
    INFLIGHT_END=
}

load_state() {
    SHIPPER=$(state_get shipper)
    case $SHIPPER in ''|*[!A-Za-z0-9_-]*) SHIPPER=$(random_hex 8) ;; esac
    SEQ=$(number_or "$(state_get seq)" 0)
    FILE_ID=$(state_get file)
    OFFSET=$(number_or "$(state_get offset)" 0)
    INFLIGHT_SEQ=$(number_or "$(state_get inflight_seq)" '')
    INFLIGHT_FILE=$(state_get inflight_file)
    INFLIGHT_START=$(number_or "$(state_get inflight_start)" '')
    INFLIGHT_END=$(number_or "$(state_get inflight_end)" '')
}

save_state() {
    printf 'shipper=%s\nseq=%s\nfile=%s\noffset=%s\ninflight_seq=%s\ninflight_file=%s\ninflight_start=%s\ninflight_end=%s\n' \
        "$SHIPPER" "$SEQ" "$FILE_ID" "$OFFSET" "$INFLIGHT_SEQ" "$INFLIGHT_FILE" "$INFLIGHT_START" "$INFLIGHT_END" \
        > "$STATE.tmp" && mv -f "$STATE.tmp" "$STATE"
}

# ---------------------------------------------------------------- files

file_id() {
    stat -c '%d:%i' "$1" 2>/dev/null
}

file_size() {
    stat -c '%s' "$1" 2>/dev/null || echo 0
}

nap() {
    slept=0
    while [ "$slept" -lt "$1" ] && [ "$STOPPING" -eq 0 ]; do
        sleep 1
        slept=$((slept + 1))
    done
}

# The newest file the --log pattern names (they sort by name: a date in it).
newest_match() {
    newest=
    for match in $PATTERN; do
        [ -f "$match" ] && newest=$match
    done
    printf '%s' "$newest"
}

# Point READING at the file being read: the log itself, or, once it was
# rotated, <log>.1 (FINAL=1: read to its very end, then move on). With a
# pattern, the log is its newest file, and any older one is the rotated one.
locate() {
    if [ -n "$PATTERN" ]; then
        LOG=$(newest_match)
        [ -n "$FILE_ID" ] && [ -n "$LOG" ] || return 1
        if [ "$(file_id "$LOG")" = "$FILE_ID" ]; then
            READING=$LOG
            FINAL=0
            return 0
        fi
        for match in $PATTERN; do
            if [ -f "$match" ] && [ "$(file_id "$match")" = "$FILE_ID" ]; then
                READING=$match
                FINAL=1
                return 0
            fi
        done
        return 1
    fi

    if [ -n "$FILE_ID" ] && [ "$(file_id "$LOG")" = "$FILE_ID" ]; then
        READING=$LOG
        FINAL=0
    elif [ -n "$FILE_ID" ] && [ "$(file_id "$LOG.1")" = "$FILE_ID" ]; then
        READING=$LOG.1
        FINAL=1
    else
        return 1
    fi
}

start_log_from() {
    READING=$LOG
    FINAL=0
    FILE_ID=$(file_id "$LOG")
    OFFSET=$1
    clear_inflight
    save_state
}

# Put the next batch in $WORK/batch: BATCH_LINES_READ lines, ending at BATCH_END.
read_batch() {
    if [ -n "$INFLIGHT_SEQ" ] && [ "$INFLIGHT_FILE" = "$FILE_ID" ] && [ "$INFLIGHT_START" = "$OFFSET" ] && [ -n "$INFLIGHT_END" ]; then
        tail -c +"$((OFFSET + 1))" "$READING" | head -c "$((INFLIGHT_END - OFFSET))" > "$WORK/raw"
    else
        tail -c +"$((OFFSET + 1))" "$READING" | head -c "$MAX_BATCH_BYTES" | head -n "$CAP" > "$WORK/raw"

        if [ -s "$WORK/raw" ] && [ "$(tail -c 1 "$WORK/raw" | od -An -tx1 | tr -d ' \n')" != 0a ]; then
            raw_size=$(file_size "$WORK/raw")
            reaches_end=$([ "$((OFFSET + raw_size))" -ge "$(file_size "$READING")" ] && echo 1 || echo 0)

            # Keep the unfinished last line only at the very end of a rotated
            # file, or when one line alone fills a batch; otherwise it waits.
            if { [ "$FINAL" -eq 0 ] || [ "$reaches_end" -eq 0 ]; } && [ "$(wc -l < "$WORK/raw")" -gt 0 ]; then
                sed '$d' "$WORK/raw" > "$WORK/raw.whole" && mv -f "$WORK/raw.whole" "$WORK/raw"
            elif [ "$FINAL" -eq 0 ] && [ "$raw_size" -lt "$MAX_BATCH_BYTES" ]; then
                : > "$WORK/raw"
            fi
        fi
    fi

    BATCH_END=$((OFFSET + $(file_size "$WORK/raw")))
    cut_long_lines < "$WORK/raw" > "$WORK/batch"
    BATCH_LINES_READ=$(wc -l < "$WORK/batch" | tr -d ' ')
    [ -s "$WORK/raw" ] || BATCH_LINES_READ=0
}

# Cut a line longer than MAX_LINE: to its start for an access log; for an
# error log, to its start and its end, where an exception names its class
# and where it was thrown.
cut_long_lines() {
    if [ -z "$ERRORS" ]; then
        cut -b "1-$MAX_LINE"
        return
    fi
    LC_ALL=C awk -v max="$MAX_LINE" '
        length($0) <= max { print; next }
        {
            keep = int((max - 64) / 2)
            print substr($0, 1, keep) " [... " (length($0) - 2 * keep) " bytes cut ...] " substr($0, length($0) - keep + 1)
        }
    '
}

# ---------------------------------------------------------------- sending

# http_post <header> [<url> <body file> <content type>]: the batch to POST_URL by default.
http_post() {
    post_to=${2:-$POST_URL}
    post_body=${3:-$WORK/batch.gz}
    post_type=${4:-text/plain; charset=utf-8}
    : > "$WORK/answer"
    : > "$WORK/headers"

    if [ "$CLIENT" = curl ]; then
        STATUS=$(curl -sS --max-time 60 -o "$WORK/answer" -D "$WORK/headers" -w '%{http_code}' \
            -H @"$WORK/auth" \
            -H "Content-Type: $post_type" \
            -H 'Content-Encoding: gzip' \
            -H "$1" \
            -A "edgelog-ship/$VERSION" \
            --data-binary @"$post_body" "$post_to" 2>"$WORK/error")
    else
        WGETRC="$WORK/wgetrc" wget -q -S -O "$WORK/answer" --content-on-error --max-redirect=0 \
            --timeout=60 --tries=1 \
            --header="Content-Type: $post_type" \
            --header='Content-Encoding: gzip' \
            --header="$1" \
            -U "edgelog-ship/$VERSION" \
            --post-file="$post_body" "$post_to" 2>"$WORK/headers"
        STATUS=$(sed -n 's/^ *HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' "$WORK/headers" | tail -n 1)
    fi

    case $STATUS in [1-5][0-9][0-9]) ;; *) STATUS=000 ;; esac
}

answer_field() {
    sed -n "s/.*\"$1\":\"\{0,1\}\([^\",}]*\).*/\1/p" "$WORK/answer" | head -n 1 | cut -c 1-300
}

retry_after() {
    wait_for=$(sed -n 's/^ *[Rr]etry-[Aa]fter: *\([0-9][0-9]*\).*/\1/p' "$WORK/headers" | tail -n 1)
    [ -n "$wait_for" ] || return 1
    [ "$wait_for" -le "$MAX_RETRY_AFTER" ] || wait_for=$MAX_RETRY_AFTER
    [ "$wait_for" -ge 1 ] || wait_for=1
    printf '%s' "$wait_for"
}

backoff() {
    ceiling=1
    step=0
    while [ "$step" -lt "$1" ] && [ "$ceiling" -lt "$BACKOFF_CAP" ]; do
        ceiling=$((ceiling * 2))
        step=$((step + 1))
    done
    [ "$ceiling" -le "$BACKOFF_CAP" ] || ceiling=$BACKOFF_CAP
    jitter=$(( $(random_number) % (ceiling + 1) ))
    [ "$jitter" -ge 1 ] || jitter=1
    printf '%s' "$jitter"
}

# Send $WORK/batch until the server keeps it. Returns 1 when --once gives up
# or the shipper is stopping.
send_batch() {
    if [ -n "$INFLIGHT_SEQ" ] && [ "$INFLIGHT_FILE" = "$FILE_ID" ] && [ "$INFLIGHT_START" = "$OFFSET" ]; then
        seq=$INFLIGHT_SEQ
    else
        seq=$((SEQ + 1))
    fi
    INFLIGHT_SEQ=$seq
    INFLIGHT_FILE=$FILE_ID
    INFLIGHT_START=$OFFSET
    INFLIGHT_END=$BATCH_END
    save_state

    gzip -c < "$WORK/batch" > "$WORK/batch.gz"
    attempt=0
    waited=0

    while :; do
        http_post "X-Edgelog-Batch: $SHIPPER:$seq"

        case $STATUS in
            2[0-9][0-9])
                SEQ=$seq
                OFFSET=$BATCH_END
                CAP=$BATCH_LINES
                clear_inflight
                save_state
                SENT_LINES=$((SENT_LINES + BATCH_LINES_READ))
                SENT_BATCHES=$((SENT_BATCHES + 1))
                rejected=$(answer_field rejected)
                [ -n "$ERRORS" ] && rejected=0
                case $rejected in ''|0|*[!0-9]*) ;; *) say "batch $seq: $rejected rejected (not in the site's log format)" ;; esac
                return 0
                ;;
            413)
                if [ "$BATCH_LINES_READ" -gt 1 ]; then
                    CAP=$((BATCH_LINES_READ / 2))
                    clear_inflight
                    save_state
                    say "the server found the batch too large; sending $CAP lines at a time"
                    return 0
                fi
                ;;
        esac

        attempt=$((attempt + 1))
        wait_for=
        case $STATUS in 429|503|507) wait_for=$(retry_after) || wait_for= ;; esac
        [ -n "$wait_for" ] || wait_for=$(backoff "$attempt")

        reason=$(answer_field error)
        [ -n "$reason" ] || reason=$(head -c 200 "$WORK/error" 2>/dev/null | tr '\n' ' ')
        [ "$STATUS" != 000 ] || STATUS=unreachable
        say "batch $seq not kept ($STATUS: ${reason:-no answer}); trying again in $wait_for s"

        if [ "$ONCE" -eq 1 ] && { [ "$attempt" -ge "$ONCE_TRIES" ] || [ "$((waited + wait_for))" -gt "$ONCE_SECONDS" ]; }; then
            say "giving up for now; the same lines are sent at the next run"
            return 1
        fi

        nap "$wait_for"
        waited=$((waited + wait_for))
        [ "$STOPPING" -eq 0 ] || return 1
    done
}

# Send the server's figures once a minute. One try: a minute the server does
# not take is skipped, said once until a minute is taken again.
send_metrics() {
    [ "$METRICS" -eq 1 ] || return 0
    [ "${1:-}" = now ] || [ "$(($(date +%s) - METRICS_AT))" -ge "$METRICS_EVERY" ] || return 0
    METRICS_AT=$(date +%s)
    read_metrics || return 0
    add_software
    gzip -c < "$WORK/metrics.json" > "$WORK/metrics.gz"
    http_post 'X-Edgelog-Metrics: 1' "${URL%/}/metrics" "$WORK/metrics.gz" 'application/json'

    case $STATUS in
        2[0-9][0-9])
            METRICS_FAILING=0
            [ "$SOFTWARE_ADDED" -eq 0 ] || SOFTWARE_AT=$(date +%s)
            ;;
        *)
            if [ "$METRICS_FAILING" -eq 0 ]; then
                reason=$(answer_field error)
                [ "$STATUS" != 000 ] || STATUS=unreachable
                say "the server's figures were not kept ($STATUS: ${reason:-no answer}); the next ones go in a minute"
            fi
            METRICS_FAILING=1
            ;;
    esac
}

# ---------------------------------------------------------------- past logs

# The file's id: the sha256 of its first line.
source_id() {
    head -n 1 "$1" | sha256sum | cut -c 1-64
}

# Put the part of $PAST from OFFSET in $WORK/batch, ending at BATCH_END.
read_past_batch() {
    tail -c +"$((OFFSET + 1))" "$PAST" | head -c "$((LIMIT - OFFSET))" | head -c "$MAX_BATCH_BYTES" | head -n "$CAP" > "$WORK/raw"
    raw_size=$(file_size "$WORK/raw")

    # An unfinished last line waits for the next part, unless the part ends
    # the file or holds that one line alone.
    if [ "$raw_size" -gt 0 ] && [ "$((OFFSET + raw_size))" -lt "$LIMIT" ] \
        && [ "$(tail -c 1 "$WORK/raw" | od -An -tx1 | tr -d ' \n')" != 0a ] && [ "$(wc -l < "$WORK/raw")" -gt 0 ]; then
        sed '$d' "$WORK/raw" > "$WORK/raw.whole" && mv -f "$WORK/raw.whole" "$WORK/raw"
    fi

    BATCH_END=$((OFFSET + $(file_size "$WORK/raw")))
    cut -b "1-$MAX_LINE" < "$WORK/raw" > "$WORK/batch"
    BATCH_LINES_READ=$(wc -l < "$WORK/batch" | tr -d ' ')
}

# Send $WORK/batch until the server keeps it or says where to go on from.
# Returns 1 after ONCE_TRIES failed tries, or when the shipper is stopping.
send_past_batch() {
    gzip -c < "$WORK/batch" > "$WORK/batch.gz"
    attempt=0

    while :; do
        http_post "X-Edgelog-Range: $SOURCE:$OFFSET-$BATCH_END"

        case $STATUS in
            2[0-9][0-9])
                OFFSET=$BATCH_END
                CAP=$BATCH_LINES
                FILE_KEPT=$((FILE_KEPT + $(number_or "$(answer_field accepted)" 0)))
                FILE_SHIPPED=$((FILE_SHIPPED + $(number_or "$(answer_field shipped)" 0)))
                FILE_REFUSED=$((FILE_REFUSED + $(number_or "$(answer_field rejected)" 0)))
                FILE_PARTS=$((FILE_PARTS + 1))
                return 0
                ;;
            409)
                if [ "$(answer_field reason)" = offset ]; then
                    OFFSET=$(number_or "$(answer_field offset)" "$LIMIT")
                    CAP=$BATCH_LINES
                    return 0
                fi
                die "$(answer_field error)"
                ;;
            413)
                if [ "$BATCH_LINES_READ" -gt 1 ]; then
                    CAP=$((BATCH_LINES_READ / 2))
                    say "the server found the part too large; sending $CAP lines at a time"
                    return 0
                fi
                ;;
        esac

        attempt=$((attempt + 1))
        wait_for=
        case $STATUS in 429|503|507) wait_for=$(retry_after) || wait_for= ;; esac
        [ -n "$wait_for" ] || wait_for=$(backoff "$attempt")

        reason=$(answer_field error)
        [ -n "$reason" ] || reason=$(head -c 200 "$WORK/error" 2>/dev/null | tr '\n' ' ')
        [ "$STATUS" != 000 ] || STATUS=unreachable
        say "part $OFFSET-$BATCH_END not kept ($STATUS: ${reason:-no answer})"

        if [ "$attempt" -ge "$ONCE_TRIES" ]; then
            say "giving up for now; run the same command again to go on where it stopped"
            return 1
        fi

        say "trying again in $wait_for s"
        nap "$wait_for"
        [ "$STOPPING" -eq 0 ] || return 1
    done
}

backfill_file() {
    name=$(basename -- "$1")

    if [ ! -r "$1" ] || [ ! -f "$1" ]; then
        say "$name: cannot be read, skipped"
        return 0
    fi

    case $1 in
        *.gz)
            if ! gzip -dc -- "$1" > "$WORK/past" 2>/dev/null; then
                say "$name: cannot be unpacked, skipped"
                return 0
            fi
            PAST=$WORK/past
            ;;
        *) PAST=$1 ;;
    esac

    LIMIT=$(file_size "$PAST")

    # A plain file may still be written to: its unfinished last line waits.
    if [ "$PAST" = "$1" ] && [ "$LIMIT" -gt 0 ] && [ "$(tail -c 1 "$PAST" | od -An -tx1 | tr -d ' \n')" != 0a ]; then
        LIMIT=$((LIMIT - $(tail -n 1 "$PAST" | wc -c)))
    fi

    if [ "$LIMIT" -eq 0 ]; then
        say "$name: empty, skipped"
        return 0
    fi

    SOURCE=$(source_id "$PAST")
    OFFSET=0
    CAP=$BATCH_LINES
    FILE_KEPT=0
    FILE_SHIPPED=0
    FILE_REFUSED=0
    FILE_PARTS=0

    while [ "$OFFSET" -lt "$LIMIT" ] && [ "$STOPPING" -eq 0 ]; do
        read_past_batch
        send_past_batch || return 1
    done

    if [ "$FILE_PARTS" -eq 0 ]; then
        say "$name: already sent"
    else
        say "$name: $FILE_KEPT lines kept, $FILE_SHIPPED already shipped live, $FILE_REFUSED refused"
        PAST_KEPT=$((PAST_KEPT + FILE_KEPT))
        PAST_FILES=$((PAST_FILES + 1))
    fi
    rm -f "$WORK/past"
}

if [ "$BACKFILL" -eq 1 ]; then
    POST_URL=${URL%/}/history
    PAST_KEPT=0
    PAST_FILES=0

    # Oldest first: by logrotate's number (access.log.3.gz before
    # access.log.2.gz), then by the time each file was last written.
    ls -1dtr -- "$@" > "$WORK/by-time" || die "the past log files cannot be listed"
    while IFS= read -r past_file; do
        number=$(printf '%s\n' "$past_file" | sed -n 's/.*\.\([0-9][0-9]*\)\(\.gz\)\{0,1\}$/\1/p')
        printf '%s\t%s\n' "${number:-0}" "$past_file"
    done < "$WORK/by-time" | sort -s -t "$(printf '\t')" -k1,1nr | cut -f 2- > "$WORK/files"

    while IFS= read -r past_file <&3 && [ "$STOPPING" -eq 0 ]; do
        backfill_file "$past_file" || exit 1
    done 3< "$WORK/files"

    say "sent $PAST_FILES files, $PAST_KEPT past lines kept; their days are counted a few minutes after the last part"
    exit 0
fi

# ---------------------------------------------------------------- main

POST_URL=$URL
[ -z "$ERRORS" ] || POST_URL="${URL%/}/errors/$ERRORS"
load_state
CAP=$BATCH_LINES
SENT_LINES=0
SENT_BATCHES=0
METRICS_AT=$(date +%s)
METRICS_FAILING=0
[ "$METRICS" -eq 0 ] || read_metrics || say "the server's figures cannot be read; they are tried again in a minute"

if [ -n "$FILE_ID" ] && locate; then
    [ "$FINAL" -eq 0 ] || say "finishing $READING, rotated while stopped"
else
    if [ -n "$FILE_ID" ]; then
        say "the file read last is gone or compressed; starting the current log from its start"
    fi
    [ -z "$PATTERN" ] || LOG=$(newest_match)
    while { [ -z "$LOG" ] || [ ! -e "$LOG" ]; } && [ "$STOPPING" -eq 0 ]; do
        say "waiting for ${LOG:-$PATTERN}"
        nap 5
        [ -z "$PATTERN" ] || LOG=$(newest_match)
    done
    [ "$STOPPING" -eq 0 ] || exit 0
    first_offset=0
    [ -n "$FILE_ID" ] || [ "$FROM_END" -eq 0 ] || first_offset=$(file_size "$LOG")
    start_log_from "$first_offset"
fi

while [ "$STOPPING" -eq 0 ]; do
    send_metrics

    if ! locate; then
        if [ -n "$LOG" ] && [ -e "$LOG" ]; then
            say "the file being read is gone; starting the current log from its start"
            start_log_from 0
        else
            [ "$ONCE" -eq 0 ] || break
            nap 1
            continue
        fi
    fi

    if [ "$(file_size "$READING")" -lt "$OFFSET" ]; then
        say "the log was truncated in place; starting it again from its start"
        OFFSET=0
        clear_inflight
        save_state
    fi

    read_batch

    if [ "$BATCH_LINES_READ" -eq 0 ]; then
        if [ "$FINAL" -eq 1 ]; then
            start_log_from 0
            continue
        fi
        [ "$ONCE" -eq 0 ] || break
        nap "$INTERVAL"
        continue
    fi

    send_batch || exit "$([ "$STOPPING" -eq 1 ] && echo 0 || echo 1)"

    if [ "$ONCE" -eq 0 ] && [ "$BATCH_LINES_READ" -lt "$CAP" ]; then
        nap "$INTERVAL"
    fi
done

if [ "$ONCE" -eq 1 ]; then
    send_metrics now
    say "sent $SENT_LINES lines in $SENT_BATCHES batches"
fi
exit 0
